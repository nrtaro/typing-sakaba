// Cloudflare Workers の静的アセット配信の設定。
// ビルド結果（dist）の配信は従来どおり。/api/* のみ Worker を先に通す。
{
  "name": "typing-sakaba",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "typing-sakaba",
      // 本番に反映する前に、ユーザーが作成した D1 の ID に置き換える。
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
