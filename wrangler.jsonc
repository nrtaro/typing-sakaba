// Cloudflare Workers の静的アセット配信の設定。
// ビルド結果（dist）の配信は従来どおり。/api/* のみ Worker を先に通す。
{
  "name": "typing-sakaba",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Workers の無料プランは1回の処理の計算時間が約10ms。遊んだ記録のやり直し（約40〜70ms）は
  // 入りきらないため止めておく（有料プランにしたら、この行を消すか "on" にする）。
  "vars": {
    "RANKING_REPLAY": "off",
    // Turnstile の公開キー（公開してよい値）。秘密キー TURNSTILE_SECRET は `wrangler secret put` で登録する。
    // 両方そろったときだけ、名前入力で確認する。
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF3LwfArFYzcipjL"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "typing-sakaba",
      // 2026-11-07 にユーザーが作成した本番 D1。
      "database_id": "35ff6810-9150-4962-a7e3-c93ddb069b75",
      "migrations_dir": "migrations"
    }
  ]
}
