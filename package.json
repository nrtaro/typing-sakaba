{
  "name": "typing-sakaba",
  "version": "0.1.0",
  "private": true,
  "description": "タイピング酒場 ～おやじと女将と看板娘～ — 家族で営む酒場の3分間タイピング営業",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "dev:worker": "wrangler dev --local --port 8787",
    "db:local": "wrangler d1 migrations apply typing-sakaba --local",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sim": "vitest run tests/day.sim.test.ts --silent=false"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nrtaro/typing-sakaba.git"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "@fontsource/dotgothic16": "^5.3.1"
  }
}
